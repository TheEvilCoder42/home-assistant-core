        "data_description": {
          "show_all_sources": "Displays all sources, even ones the receiver marks as deleted",
          "update_audyssey": "Updates the audio settings on a schedule while Telnet is not connected, which can take up to 10 seconds on some receivers. Without it, they only update on demand",
          "use_telnet": "Enables real-time updates. Only one Telnet connection to the receiver is allowed at a time",
